{
 "event": [
  {
   "listen": "prerequest",
   "script": {
    "exec": [
     "var base = pm.variables.get('baseUrl') || 'http://127.0.0.1:8000';",
     "var origin = (base.match(/^[a-z]+:\\/\\/[^\\/]+/i) || [base])[0];",
     "var isSession = pm.request.method === 'POST' && /\\/api\\/v1\\/demo\\/sessions$/.test(pm.request.url.getPath());",
     "pm.request.headers.upsert({key: 'Origin', value: origin});",
     "var sid = pm.collectionVariables.get('sessionId');",
     "var csrf = pm.collectionVariables.get('csrfToken');",
     "if (!isSession && sid) { pm.request.headers.upsert({key: 'X-Demo-Session', value: sid}); }",
     "if (!isSession && csrf && pm.request.method !== 'GET') { pm.request.headers.upsert({key: 'X-CSRF-Token', value: csrf}); }"
    ],
    "type": "text/javascript"
   }
  }
 ],
 "info": {
  "description": "25 requests that are safe in the default local demo mode (no PayPal key, no model key, no outside network). A collection-level pre-request script adds the Origin header and the X-Demo-Session / X-CSRF-Token headers; the first request creates the session and stores both values. Run it in order. Requests marked negative case are deliberate refusals and are expected to answer 4xx. Run: newman run postman_run_collection.json --env-var baseUrl=http://127.0.0.1:8000",
  "name": "TradeGlot local console API - run collection",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "item": [
  {
   "event": [
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test('session created (201, synthetic)', function () {",
       "  pm.response.to.have.status(201);",
       "  var j = pm.response.json();",
       "  pm.expect(j.source).to.eql('synthetic');",
       "  pm.expect(j.session_id).to.be.a('string').and.not.empty;",
       "  pm.expect(j.csrf_token).to.be.a('string').and.not.empty;",
       "  pm.collectionVariables.set('sessionId', j.session_id);",
       "  pm.collectionVariables.set('csrfToken', j.csrf_token);",
       "});"
      ],
      "type": "text/javascript"
     }
    }
   ],
   "name": "01 Create demo session",
   "request": {
    "body": {
     "mode": "raw",
     "options": {
      "raw": {
       "language": "json"
      }
     },
     "raw": "{}"
    },
    "description": "Starts a synthetic demo session; its id and CSRF token are stored in collection variables for every later request. Expected status 201.",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "method": "POST",
    "url": {
     "host": [
      "{{baseUrl}}"
     ],
     "path": [
      "api",
      "v1",
      "demo",
      "sessions"
     ],
     "raw": "{{baseUrl}}/api/v1/demo/sessions"
    }
   }
  },
  {
   "event": [
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
