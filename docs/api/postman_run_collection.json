       "pm.test(\"status is \\\"ok\\\"\", function () { pm.expect(pm.response.json()[\"status\"]).to.eql(\"ok\"); });",
       "pm.test(\"source is \\\"synthetic\\\"\", function () { pm.expect(pm.response.json()[\"source\"]).to.eql(\"synthetic\"); });"
