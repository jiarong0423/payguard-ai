 "selector_allowlist": [
  {
   "selector": ".evidence-toolbar.tg-block [data-testid=\"dispute-draft\"]:enabled",
   "reason": "the Disputes step's one primary button; it has no class of its own, only its test id, inside the Next step module"
  },
  {
   "selector": "#compliance .tg-block--ck-sample > p:not(.check-three__result)",
   "reason": "the sample's caption paragraph inside the Check a sale sample module (ledger-row column 3)"
  },
  {
   "selector": "#compliance .stage-content:has(> .tg-mod)",
   "reason": "1024-1279px only: the 5:7 grid needs the Check a sale step container (page-level); scoped by #compliance and :has(> .tg-mod), carries no module class"
  },
  {
   "selector": "#compliance .stage-content:has(> .tg-mod) > *",
   "reason": "same 1024-1279px grid: every child of that step container spans both columns unless placed below"
  },
  {
   "selector": "#compliance .stage-content > .stage-block:has(> .tg-mod)",
   "reason": "same grid: the country check block goes to column 2"
  },
  {
   "selector": ".tg-mod--vs-focus .vs-fig > *",
   "reason": "Sales spike figure parts wrap inside the 4:8 focus module"
  },
  {
   "selector": ".stage-accordion:has(.tg-mod--vs-focus) .guide-live-input",
   "reason": "D-P19: in the 306px guide rail of the Sales spike step the sentence box takes the full row (guide rail is outside the step modules)"
  },
  {
   "selector": ".stage-accordion:has(.tg-mod--vs-focus) .guide-live-input > input",
   "reason": "same D-P19 rule: the guide input takes the full row so its placeholder is never cut"
  },
  {
   "selector": ".tg-block--ds-ai .ds-ai__tryrow > *",
   "reason": "A5: the AI try-it input and its Check button are 44px touch targets inside the Disputes AI module"
  },
  {
   "selector": ".tg-box--ck-rules > #country-view-rows > ul",
   "reason": "the key-rules list inside the Check a sale rules box starts flush"
  },
  {
   "selector": ".tg-box--vs-facts > * + *",
   "reason": "spacing between the facts inside the Sales spike facts fold"
  },
  {
   "selector": ":is(.tg-box--vs-facts, .tg-box--ov-steps) > summary",
   "reason": "the summary line of these two module folds (hidden above 640px, a 44px row below)"
  },
  {
   "selector": ".tg-box--ov-steps[open] > summary",
   "reason": "open Overview steps fold: space under its summary"
  },
  {
   "selector": ".tg-box--ov-replay > summary",
   "reason": "the summary line of the Overview replay fold module"
  },
  {
   "selector": ".tg-box--ov-replay[open] > summary",
   "reason": "open replay fold: space under its summary"
  },
  {
   "selector": ":is(#analytics, #activity)",
   "reason": "N1 PF10: the two optional folds under Overview (order table, session activity) by their own ids, flat ledger rows instead of the old framed cards; outside every module because they are page-level sections"
  },
  {
   "selector": ":is(#analytics, #activity) > .optional-heading .optional-trigger",
   "reason": "N1 PF10: the trigger row of those two folds loses the old panel background"
  },
  {
   "selector": ".tg-mod--ds-board .board-list .board-row dl > div:nth-child(5)",
   "reason": "N1 PF3: the board card's Plan row (fifth field, no class of its own) inside the Deadline board module; its 68px minimum height left about 100px blank under every card"
  },
  {
   "selector": ".tg-mod--ds-board .board-list .board-row-noplan dl > div:nth-child(5)",
   "reason": "N1 PF3: same Plan row on a card with no plan"
  },
  {
   "selector": ".tg-mod--ds-board .board-chips > button",
   "reason": "N1 PF4: the board's five filter buttons (no class of their own) inside the Deadline board module: one width, one alignment"
  },
  {
   "selector": ".tg-legend__note",
   "reason": "N1 C13: the source legend's extra note (\"Not the local console.\") is a native fold inline with its sentence; theme/sources.js builds the legend with createElement and is not a module element"
  },
  {
   "selector": ".tg-legend__note > summary",
   "reason": "N1 C13: the ⓘ mark of that note"
  },
  {
   "selector": ".tg-legend-fold > summary",
   "reason": "N1 C13: on a phone the legend is one fold whose summary names the four labels"
  },
  {
   "selector": "svg[data-icon]",
   "reason": "N1 icon alignment (coordinator ruling 2026-11-12): every sprite icon (theme/iconMap.js SpriteIcon, data-icon) centres on the first line of its text: inline-block, top of the line or flex-start, then half a line minus half its own height. One rule for the whole site instead of per-point fixes; measured by scratchpad/clickall/icon_align.py"
  },
  {
   "selector": ":has(> svg[data-icon]):not(.tg-stamp, .tg-tag, .tg-pill)",
   "reason": "N1 icon alignment: the row that holds an icon aligns its items to the top so the text's first line and the icon start together (align-items only acts on flex and grid rows) Coordinator X04 (judge B-1/B-3): fixed-height stamps and tags excluded so their single line stays centred."
  },
  {
   "selector": ".button:has(> svg[data-icon])",
   "reason": "N1 icon alignment: a button with an icon becomes one centred grid row (align-content) so its single line stays in the middle of its minimum height while icon and text align to the first line"
  },
  {
   "selector": "a.tg-link:has(> svg[data-icon])",
   "reason": "N1 icon alignment: the same for a link row with a minimum height (Next: step links)"
  },
  {
   "selector": ".sandbox-details > summary:has(> svg[data-icon]) > span + span",
   "reason": "N1 icon alignment: a summary's second item (status badge) goes to the right end (margin auto), on the title's line or on its own line when it wraps"
  },
  {
   "selector": ".sandbox-details > summary:has(> svg[data-icon])",
   "reason": "N1 icon alignment: a summary row with an icon keeps its title next to the icon (justify-content flex-start instead of space-between, which pushed the title 47px away at 393)"
  },
  {
   "selector": ":where(h1, h2, h3, h4, button, summary, th, .tg-tag)",
   "reason": "N1 text audit (coordinator 2026-11-12, T1 text_audit.md A): headings, buttons, summaries, table heads and tags balance their lines so no word is left alone on a line"
  },
  {
   "selector": ":where(p, li, dd, blockquote, figcaption, .footer-independent)",
   "reason": "N1 text audit A: running text (and the footer's independence line) keeps at most about 80 characters a line: 62ch, zero specificity, so any page rule that sets its own width wins"
  },
  {
   "selector": ".tg-mod--ds-board .board-list .board-row dt::after",
   "reason": "N1 C07: the board card labels now carry their colon as text (copy v4.1 'Amount: 125.50 USD'); the generated ': ' after each label inside the Deadline board module is removed"
  },
  {
   "selector": ".tg-mod--ds-board .board-list .board-row dl > div:nth-child(5) dt",
   "reason": "Coordinator X03: the board card Plan field label (fifth field, no class of its own) was screen-reader only in board.css:138; shown like the other four fields"
  },
  {
   "selector": ":is(.tg-stamp, .tg-tag, .tg-pill) > svg[data-icon]",
   "reason": "Coordinator X04 (judges A#1, B-1, B-3): one-line stamps, tags and pills centre their icon; the global first-line offset is for multi-line text only"
  },
  {
   "selector": ".tg-mod--ds-board .board-list :is(.board-row-due_soon, .board-row-due_soon_no_draft, .board-row-due_soon_missing):not(.board-row-urgent)",
   "reason": "Coordinator X07 (judge A#3): board cards due within 3 days but not within 1 use the warn colour, matching the case queue; red only for 1 day or past due"
  },
  {
   "selector": ".tg-mod--ds-board .board-list :is(.board-row-due_soon, .board-row-due_soon_no_draft, .board-row-due_soon_missing):not(.board-row-urgent) .board-row-status",
   "reason": "Coordinator X07 (judge A#3): board cards due within 3 days but not within 1 use the warn colour, matching the case queue; red only for 1 day or past due"
  },
  {
   "selector": ".tg-mod--ds-board .board-timeline:not(.board-timeline-phone) .board-canvas .payguard-board-plan .ev-label",
   "reason": "Coordinator X10 (red-team PF2 at 1440): desktop plan label sits left of its bar so it never crosses the due line or overflows the bar"
  },
  {
   "selector": ".tg-box--ck-keyfold > #country-view-rows > ul",
   "reason": "J-B (A request 23:08): the key-rules list inside the Check a sale key-rules fold starts flush under its summary; the ul has no class of its own (CountryRules.jsx rules()), same rule as .tg-box--ck-rules > #country-view-rows > ul one level down"
  },
  {
   "selector": ".tg-box--ck-keyfold > summary",
   "reason": "J-B item 1: the summary line (\"See the n rules\") of the Check a sale key-rules fold (CountryRules.jsx, A) is a 44px row like the other folds; the summary has no class of its own"
  },
  {
   "selector": ".tg-box--ck-keyfold[open] > summary",
   "reason": "J-B item 1: same key-rules fold summary when open: space under it"
  },
  {
   "selector": ".tg-mod .country-all-rules > summary",
   "reason": "Coordinator K4 (text_audit compliance@1440): the See all rules and notes fold title fits one line in the 179px rules column from 1200px; balanced wrap below"
  },
  {
   "selector": ".tg-box--fold + .tg-source",
   "reason": "Coordinator K5 (user 2026-11-13): the source line under a copy fold sat on the fold; 8px gap"
  },
  {
   "selector": ".sponsor-map > summary",
   "reason": "Coordinator K5 (user 2026-11-13): footer Sponsor map text and chevron ran to the edges; inset to match the Session activity row"
  },
  {
   "selector": ":is(#compliance, #velocity) .stage-content :is(#sandbox-draft, .step-more.tg-mod, .tg-fold--guide)",
   "reason": "Coordinator K5 (user 2026-11-13): folds under Check a sale and Sales spike sat at 0, 12 and 16px from the stage edge; one edge for all"
  },
  {
   "selector": ":is(#compliance, #velocity) .step-more.tg-mod > summary",
   "reason": "Coordinator K5 (user 2026-11-13): More fold title uses the same 16px inset as the other step folds"
  },
  {
   "selector": ".tg-mod--ck-three .check-three__row > .check-three__card.tg-block--ck-sample.tg-block > *",
   "reason": "Coordinator K12 (user 2026-11-13): sample cards in the Three sample sales fold stack in one column; children span the single column so text never overlaps"
  }
 ],
